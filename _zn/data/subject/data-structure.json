guages-solution","level":3,"title":"詳解","fold":true,"children":[]}]},{"id":"q-pros-cons","level":2,"title":"遞迴的優缺點","fold":false,"children":[{"id":"q-pros-cons-solution","level":3,"title":"詳解","fold":true,"children":[]}]}]},{"path":"data-structure/ch6-tree.mdx","slug":"ch6-tree","format":"mdx","url":"/data-structure/ch6-tree","meta":{"title":"第 6 章 樹狀結構","tags":["課本"],"order":6,"summary":"樹的術語（樹根、樹葉、分支度、階度、祖先兄弟），串列與左子右弟表示法，二元樹的定義、種類（歪斜、完滿、完整）與性質，鏈結、一維陣列（互動編號）與二維陣列表示法，前序／中序／後序追蹤（逐步動畫）與運算式樹，由追蹤結果重建二元樹，引線二元樹，二元搜尋樹的建立與刪除（互動操作），AVL 樹的 LL／RR／LR／RL 調整（旋轉前後對照），B 樹的插入分裂與刪除，以及互斥集合與霍夫曼編碼（逐步建樹）"},"toc":[{"id":"symbol-table","level":2,"title":"代號意思表","fold":false,"children":[]},{"id":"glossary","level":2,"title":"名詞表","fold":false,"children":[]},{"id":"ch6-map","level":2,"title":"本章地圖","fold":false,"children":[]},{"id":"tree-basics","level":2,"title":"樹的基本概念","fold":false,"children":[]},{"id":"tree-list-repr","level":2,"title":"樹的串列表示法","fold":false,"children":[]},{"id":"left-child-right-sibling","level":2,"title":"左子右弟表示法","fold":false,"children":[]},{"id":"binary-tree","level":2,"title":"二元樹","fold":false,"children":[]},{"id":"binary-tree-properties","level":2,"title":"二元樹的性質","fold":false,"children":[{"id":"leaf-count-proof","level":3,"title":"為什麼 n0 = n2 + 1","fold":true,"children":[]}]},{"id":"binary-tree-linked","level":2,"title":"二元樹的鏈結表示法","fold":false,"children":[]},{"id":"binary-tree-array","level":2,"title":"二元樹的一維陣列表示法","fold":false,"children":[]},{"id":"binary-tree-2d-array","level":2,"title":"二元樹的二維陣列表示法","fold":false,"children":[]},{"id":"traversal","level":2,"title":"二元樹的追蹤","fold":false,"children":[{"id":"ex-traversal","level":3,"title":"例子：三種追蹤","fold":true,"children":[]}]},{"id":"expression-tree","level":2,"title":"運算式樹","fold":false,"children":[]},{"id":"rebuild-tree","level":2,"title":"由追蹤結果重建二元樹","fold":false,"children":[]},{"id":"threaded-binary-tree","level":2,"title":"引線二元樹","fold":false,"children":[{"id":"ex-threads","level":3,"title":"例子：引線怎麼接","fold":
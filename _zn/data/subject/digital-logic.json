-nor-complete","level":3,"title":"例子：NAND 與 NOR 是函數完全集合","fold":true,"children":[]}]},{"id":"sop-pos","level":2,"title":"SOP 與 POS","fold":false,"children":[{"id":"ex-sop-to-pos","level":3,"title":"例子：把 SOP 改寫成 POS","fold":true,"children":[]}]},{"id":"minterm-maxterm","level":2,"title":"最小項與最大項","fold":false,"children":[]},{"id":"minterm-maxterm-relation","level":2,"title":"最小項與最大項的關係","fold":false,"children":[]},{"id":"shannon","level":2,"title":"Shannon 展開定理","fold":false,"children":[{"id":"ex-shannon","level":3,"title":"例子：Shannon 展開","fold":true,"children":[]}]},{"id":"canonical-form","level":2,"title":"標準式","fold":false,"children":[{"id":"ex-canonical-by-expansion","level":3,"title":"例子：用展開定理求標準式","fold":true,"children":[]}]},{"id":"to-canonical-sop","level":2,"title":"求標準 SOP","fold":false,"children":[{"id":"ex-canonical-sop","level":3,"title":"例子：標準 SOP","fold":true,"children":[]}]},{"id":"to-canonical-pos","level":2,"title":"求標準 POS","fold":false,"children":[{"id":"ex-canonical-pos","level":3,"title":"例子：標準 POS","fold":true,"children":[]}]},{"id":"canonical-conversion","level":2,"title":"標準式互換","fold":false,"children":[]},{"id":"complement-function","level":2,"title":"求補數函數","fold":false,"children":[{"id":"ex-complement-function","level":3,"title":"例子：標準式下的補數函數","fold":true,"children":[]}]},{"id":"dual-function","level":2,"title":"對偶函數","fold":false,"children":[{"id":"ex-dual-function","level":3,"title":"例子：標準式下的對偶函數","fold":true,"children":[]}]},{"id":"basic-gates","level":2,"title":"基本邏輯閘","fold":false,"children":[]},{"id":"gate-applications","level":2,"title":"邏輯閘的基本應用","fold":false,"children":[]},{"id":"implementation","level":2,"title":"交換函數的執行","fold":false,"children":[{"id":"ex-gate-implementation","level":3,"title":"例子：用基本閘執行交換函數","fold":true,"children":[]}]}]},{"path":"digital-logic/ch2-exercises.md","slug":"ch2-exercises","format":"md","url":"/digital-logic/ch2-exercises","meta":{"title":"第 2 章 程度考題","tags":["習題"],"order":2.5,"summary":"第二章程度考題詳解：對